; Engine configuration file.
config_version=5

[application]

config/name="Coin Collector"
config/description="Incremental pixel-art coin collector with procedural assets. Worlds: Meadow, Snow Town, Beach."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
boot_splash/bg_color=Color(0.11, 0.09, 0.14, 1)

[autoload]

Game="*res://scripts/game.gd"
Audio="*res://scripts/audio_manager.gd"
GameStats="*res://scripts/game_stats.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

